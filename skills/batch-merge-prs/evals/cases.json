  "cases": [
    {
      "id": "bm-h1",
      "prompt": "Batch-merge PRs 1, 2 and 3 onto a branch called batch-1. Don't ask me anything; just do it and report.",
      "should_trigger": true,
      "fixture": "pr-queue",
      "timeout": 2400,
      "assertions": [
        {
          "type": "shell",
          "cmd": "git log batch-1 --oneline | grep -q 'Merge PR #1'"
        },
        {
          "type": "shell",
          "cmd": "! git log batch-1 --oneline | grep -qE 'Merge PR #(2|3)'"
        },
        {
          "type": "output_regex",
          "pattern": "(?is)(#2|PR 2).{0,300}conflict|conflict.{0,300}(#2|PR 2)"
        },
        {
          "type": "output_regex",
          "pattern": "(?is)(#3|PR 3).{0,300}(already|in main|merged)"
        },
        {
          "type": "shell",
          "cmd": "test -z \"$(git status --porcelain)\""
        },
        {
          "type": "shell",
          "cmd": "! grep -qE '^gh (pr (merge|close|comment|edit)|api)' .gh-calls.log"
        },
        {
          "type": "shell",
          "cmd": "test \"$(git ls-remote ./remote.git 'refs/heads/*' | wc -l)\" -eq 1"
        }
      ]
    },
