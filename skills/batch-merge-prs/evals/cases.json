{
  "skill": "batch-merge-prs",
  "fixtures": {
    "pr-queue": {
      "steps": [
        {
          "files": {
            ".gitignore": ".claude/\nremote.git/\n.gh-calls.log\n.fixture/\nbin/\n__pycache__/\n",
            "AGENTS.md": "# Agent guide\n\n## Commands\n\n- Tests: `make test` \u2014 safe to run unattended.\n",
            "README.md": "# demo\n\nWelcom to the demo project.\n\nPasswords must be at least 8 characters long.\n",
            "Makefile": "test:\n\tpython3 -m unittest -q\n",
            "core.py": "def add(a, b):\n    return a + b\n",
            "test_core.py": "import unittest\n\nfrom core import add\n\n\nclass AddTest(unittest.TestCase):\n    def test_add(self):\n        self.assertEqual(add(2, 3), 5)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
            "bin/gh": "#!/usr/bin/env bash\n# Fake gh CLI for evals: logs every call, serves canned PR data.\necho \"gh $*\" >> .gh-calls.log\nq=\"\"; prev=\"\"\nfor a in \"$@\"; do\n  if [ \"$prev\" = \"-q\" ] || [ \"$prev\" = \"--jq\" ]; then q=$a; fi\n  prev=$a\ndone\n# Evaluate a simple jq path such as .title or '.mergeCommit.oid // \"\"'.\njqpath() {\n  python3 -c 'import json, sys\nv = json.load(open(sys.argv[1]))\nfor k in sys.argv[2].split(\"//\")[0].strip().lstrip(\".\").split(\".\"):\n    v = v.get(k) if isinstance(v, dict) and k else v\nprint(\"\" if v is None else str(v).lower() if isinstance(v, bool) else v)' \"$1\" \"$2\"\n}\ncase \"$1 $2\" in\n  \"auth status\") echo \"Logged in to github.com (fake)\"; exit 0 ;;\n  \"pr list\") cat .fixture/pr-list.json; exit 0 ;;\n  \"pr view\")\n    f=\".fixture/pr-$3-view.json\"\n    [ -f \"$f\" ] || { echo \"no pull requests found for #$3\" >&2; exit 1; }\n    if [ -n \"$q\" ]; then jqpath \"$f\" \"$q\"; else cat \"$f\"; fi\n    exit 0 ;;\n  \"pr diff\") cat \".fixture/pr-$3.diff\"; exit 0 ;;\n  \"issue list\") echo \"[]\"; exit 0 ;;\n  \"repo view\")\n    if [ -n \"$q\" ]; then echo \"acme/demo\"; else echo '{\"nameWithOwner\":\"acme/demo\"}'; fi\n    exit 0 ;;\n  *) echo \"{}\"; exit 0 ;;\nesac\n",
            ".fixture/pr-list.json": "[\n  {\n    \"number\": 1,\n    \"title\": \"docs: fix typo in README\",\n    \"author\": {\n      \"login\": \"alice\"\n    },\n    \"headRefName\": \"pr-1\",\n    \"baseRefName\": \"main\",\n    \"isDraft\": false,\n    \"mergeable\": \"MERGEABLE\",\n    \"labels\": [],\n    \"additions\": 1,\n    \"deletions\": 1,\n    \"changedFiles\": 1\n  },\n  {\n    \"number\": 2,\n    \"title\": \"docs: reword README intro\",\n    \"author\": {\n      \"login\": \"bob\"\n    },\n    \"headRefName\": \"pr-2\",\n    \"baseRefName\": \"main\",\n    \"isDraft\": false,\n    \"mergeable\": \"MERGEABLE\",\n    \"labels\": [],\n    \"additions\": 1,\n    \"deletions\": 1,\n    \"changedFiles\": 1\n  },\n  {\n    \"number\": 4,\n    \"title\": \"fix: simplify add\",\n    \"author\": {\n      \"login\": \"carol\"\n    },\n    \"headRefName\": \"pr-4\",\n    \"baseRefName\": \"main\",\n    \"isDraft\": false,\n    \"mergeable\": \"MERGEABLE\",\n    \"labels\": [],\n    \"additions\": 1,\n    \"deletions\": 1,\n    \"changedFiles\": 1\n  },\n  {\n    \"number\": 5,\n    \"title\": \"feat: add password check\",\n    \"author\": {\n      \"login\": \"dave\"\n    },\n    \"headRefName\": \"pr-5\",\n    \"baseRefName\": \"main\",\n    \"isDraft\": false,\n    \"mergeable\": \"MERGEABLE\",\n    \"labels\": [],\n    \"additions\": 1,\n    \"deletions\": 1,\n    \"changedFiles\": 1\n  }\n]\n",
            ".fixture/pr-1-view.json": "{\"number\": 1, \"title\": \"docs: fix typo in README\", \"state\": \"OPEN\", \"isDraft\": false, \"mergeCommit\": null, \"mergeable\": \"MERGEABLE\", \"mergeStateStatus\": \"CLEAN\", \"statusCheckRollup\": []}\n",
            ".fixture/pr-2-view.json": "{\"number\": 2, \"title\": \"docs: reword README intro\", \"state\": \"OPEN\", \"isDraft\": false, \"mergeCommit\": null, \"mergeable\": \"MERGEABLE\", \"mergeStateStatus\": \"CLEAN\", \"statusCheckRollup\": []}\n",
            ".fixture/pr-4-view.json": "{\"number\": 4, \"title\": \"fix: simplify add\", \"state\": \"OPEN\", \"isDraft\": false, \"mergeCommit\": null, \"mergeable\": \"MERGEABLE\", \"mergeStateStatus\": \"CLEAN\", \"statusCheckRollup\": []}\n",
            ".fixture/pr-5-view.json": "{\"number\": 5, \"title\": \"feat: add password check\", \"state\": \"OPEN\", \"isDraft\": false, \"mergeCommit\": null, \"mergeable\": \"MERGEABLE\", \"mergeStateStatus\": \"CLEAN\", \"statusCheckRollup\": []}\n"
          }
        },
        {
          "run": [
            "git init -q -b main",
            "git add -A",
            "git commit -qm 'feat: initial'",
            "git init -q --bare remote.git",
            "git remote add origin ./remote.git",
            "git push -q origin main"
          ]
        },
        {
          "run": [
            "git checkout -q main",
            "git checkout -qb pr-1"
          ]
        },
        {
          "files": {
            "README.md": "# demo\n\nWelcome to the demo project.\n\nPasswords must be at least 8 characters long.\n"
